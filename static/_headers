# Cloudflare Pages response headers.

# The pages link the stylesheets with ?v=<content hash> (see the asset
# template function), so a new version always gets a new URL.
/tailwind.css
  Cache-Control: public, max-age=31536000, immutable
/blog.css
  Cache-Control: public, max-age=31536000, immutable

# Image names are not versioned: give a new name to an image whose content
# changes, or visitors may keep the old one for up to 30 days.
/images/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
